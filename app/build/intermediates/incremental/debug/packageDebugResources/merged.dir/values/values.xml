<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FBF7F2</color>
    <color name="card">#FFFFFF</color>
    <color name="divider">#EADFD8</color>
    <color name="gold">#B8893B</color>
    <color name="primary">#5B2245</color>
    <color name="primary_dark">#3A1530</color>
    <color name="text_dark">#2A1F2D</color>
    <color name="text_muted">#8B7A84</color>
    <color name="white">#FFFFFF</color>
    <string name="add_fav">♡  Save to favorites</string>
    <string name="app_name">Scentoria</string>
    <string name="nav_compare">Compare</string>
    <string name="nav_favorites">Favorites</string>
    <string name="nav_foryou">For You</string>
    <string name="nav_profile">Profile</string>
    <string name="nav_search">Discover</string>
    <string name="remove_fav">♥  Remove from favorites</string>
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="StatBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="StatNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.Scentoria" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>